extends Node
## Autoload: plays sound effects (SFX bus) and music (Music bus). The sounds
## are generated by tools/gen_audio.py into assets/. Every button in the game
## clicks automatically. Keeps running while the game is paused (menus).

const SFX_DIR := "res://assets/sounds/"
const MUSIC_DIR := "res://assets/music/"
const VOICES := 12
## The same sound won't restart within this many milliseconds.
const REPEAT_GAP_MS := 40
const FADE := 0.6

## Recent sounds and music changes, newest last (tests check these).
var history: Array[String] = []
var current_music := ""

var _sounds := {}
var _voices: Array[AudioStreamPlayer] = []
var _next := 0
var _last_played := {}
var _music: AudioStreamPlayer
var _music_tween: Tween


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = &"SFX"
		add_child(p)
		_voices.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = &"Music"
	add_child(_music)
	get_tree().node_added.connect(_on_node_added)


## Plays a sound effect by name (a file in assets/sounds/), with a little
## random pitch variation so repeats don't sound robotic.
func play(sound: String, volume_db := 0.0, pitch_variation := 0.06) -> void:
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(sound, -100000)) < REPEAT_GAP_MS:
		return
	var stream := _load(SFX_DIR + sound + ".wav", false)
	if stream == null:
		return
	_last_played[sound] = now
	_remember(sound)
	var p := _voices[_next]
	_next = (_next + 1) % VOICES
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_variation, pitch_variation)
	p.play()


## Switches to a looping music track ("" stops the music). Fades between tracks.
func play_music(track: String) -> void:
	if track == current_music:
		return
	current_music = track
	_remember("music:" + track)
	if _music_tween:
		_music_tween.kill()
	_music_tween = create_tween()
	if _music.playing:
		_music_tween.tween_property(_music, "volume_db", -40.0, FADE * 0.5)
	_music_tween.tween_callback(_start_music.bind(track))


func _start_music(track: String) -> void:
	_music.stop()
	# Headless runs (tests, make check) can't hear it, and the dummy audio
	# driver would keep the looping stream alive at exit.
	if track == "" or DisplayServer.get_name() == "headless":
		return
	var stream := _load(MUSIC_DIR + track + ".ogg", true)
	if stream == null:
		return
	_music.stream = stream
	_music.volume_db = -40.0
	_music.play()
	create_tween().tween_property(_music, "volume_db", 0.0, FADE)


func _load(path: String, loop: bool) -> AudioStream:
	if _sounds.has(path):
		return _sounds[path]
	if not ResourceLoader.exists(path):
		push_warning("Missing sound %s (run make audio)" % path)
		_sounds[path] = null
		return null
	var stream := load(path) as AudioStream
	if stream is AudioStreamOggVorbis and loop:
		stream = stream.duplicate()
		(stream as AudioStreamOggVorbis).loop = true
	_sounds[path] = stream
	return stream


func _remember(entry: String) -> void:
	history.append(entry)
	if history.size() > 200:
		history.pop_front()


func _on_node_added(node: Node) -> void:
	if node is BaseButton:
		(node as BaseButton).pressed.connect(play.bind("menu_click", -6.0, 0.0))


func _exit_tree() -> void:
	# Release streams so nothing is left playing when the game quits.
	_music.stop()
	_music.stream = null
	for p in _voices:
		p.stop()
		p.stream = null
	_sounds.clear()
