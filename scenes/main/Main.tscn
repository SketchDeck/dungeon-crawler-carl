[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/main/Main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/HUD.tscn" id="4_hud"]
[ext_resource type="Script" path="res://scripts/RoomManager.gd" id="5_rooms"]
[ext_resource type="PackedScene" path="res://scenes/ui/GameOver.tscn" id="6_gameover"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="Room" type="Node2D" parent="."]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="RoomManager" type="Node" parent="."]
script = ExtResource("5_rooms")

[node name="HUD" parent="." instance=ExtResource("4_hud")]

[node name="GameOver" parent="." instance=ExtResource("6_gameover")]
