; Engine configuration file.
; Edit this file through the Godot editor when possible.

config_version=5

[application]

config/name="Dungeon Crawler Carl"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Controls="*res://scripts/autoload/controls.gd"
Save="*res://scripts/autoload/save_manager.gd"
Fx="*res://scripts/autoload/fx.gd"
Game="*res://scripts/autoload/game_manager.gd"
CombatState="*res://scripts/autoload/combat_state.gd"
DungeonAI="*res://scripts/autoload/dungeon_ai.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.09, 1)
